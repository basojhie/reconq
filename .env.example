# Telegram bot token from @BotFather. Never commit a real token.
TELEGRAM_BOT_TOKEN=replace_with_new_bot_token
TELEGRAM_ALLOWED_USER_IDS=
RECON_COOLDOWN_SECONDS=30
LOG_LEVEL=INFO

# Optional GitHub workflow dispatch/read token for /scan and /last.
# Classic PAT: repo scope for private repos or public_repo plus workflow;
# fine-grained token: Actions read/write and Contents read for this repo.
GITHUB_TOKEN=
GITHUB_OWNER=basojhie
GITHUB_REPO=reconq
