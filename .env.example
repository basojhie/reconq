# Copy to .env and provide a newly rotated token from @BotFather.
TELEGRAM_BOT_TOKEN=replace_with_new_bot_token
# Optional comma-separated Telegram numeric user IDs. Empty means no allowlist.
TELEGRAM_ALLOWED_USER_IDS=
# Minimum number of seconds between recon commands per Telegram user (minimum 5).
RECON_COOLDOWN_SECONDS=30
LOG_LEVEL=INFO
