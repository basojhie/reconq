#!/data/data/com.termux/files/usr/bin/bash
# ReconQ Termux command center. Requires: curl, jq, GitHub PAT with Actions read/write.
set -euo pipefail

OWNER="${RECONQ_OWNER:-basojhie}"
REPO="${RECONQ_REPO:-reconq}"
WORKFLOW="${RECONQ_WORKFLOW:-recon.yml}"
API="https://api.github.com/repos/${OWNER}/${REPO}"

need() { command -v "$1" >/dev/null 2>&1 || { echo "Missing: $1"; exit 1; }; }
config() {
  : "${GITHUB_TOKEN:?Set GITHUB_TOKEN first}"
  need curl; need jq
}
api() {
  curl -fsS -H "Accept: application/vnd.github+json" \
    -H "Authorization: Bearer ${GITHUB_TOKEN}" \
    -H "X-GitHub-Api-Version: 2022-11-28" "$@"
}
usage() { echo "Usage: reconq {menu|baseline [domain]|recon [domain]|last|status RUN_ID}"; }
trigger() {
  local mode="$1" baseline="false" target="${2:-}"
  [[ "$mode" == "baseline" ]] && baseline="true"
  config
  api -X POST "${API}/actions/workflows/${WORKFLOW}/dispatches" \
    -d "$(jq -nc --arg ref main --arg mode "$mode" --arg baseline "$baseline" --arg target "$target" \
      '{ref:$ref,inputs:{mode:$mode,baseline:$baseline,target:$target}}')"
  echo "Workflow requested: mode=${mode}, baseline=${baseline}"
}
list_runs() {
  config
  api "${API}/actions/workflows/${WORKFLOW}/runs?per_page=10" | \
    jq -r '.workflow_runs[] | [.id,.status,.conclusion,.created_at,.html_url] | @tsv'
}
status_run() {
  config
  local id="${1:?Usage: reconq status RUN_ID}"
  api "${API}/actions/runs/${id}" | \
    jq -r '"Run: \(.id)\nStatus: \(.status)\nConclusion: \(.conclusion // "pending")\nURL: \(.html_url)"'
}
menu() {
  echo "ReconQ — Cloud ASM command"
  echo "1) Passive baseline (seed state, no alerts)"
  echo "2) Passive recon + safe metadata"
  echo "3) Latest workflow runs"
  echo "4) Check run ID"
  read -r -p "Choose [1-4]: " choice
  case "$choice" in
    1) trigger baseline;;
    2) trigger recon;;
    3) list_runs;;
    4) read -r -p "Run ID: " id; status_run "$id";;
    *) usage; exit 1;;
  esac
}
case "${1:-menu}" in
  menu) menu;;
  baseline) trigger baseline "${2:-}";;
  full|recon) trigger recon "${2:-}";;
  status) status_run "${2:-}";;
  last) list_runs;;
  *) usage; exit 1;;
esac
